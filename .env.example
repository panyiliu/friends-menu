# 复制为 .env 后按需修改（.env 不会被 Git 跟踪）
#   cp .env.example .env

# 宿主机映射端口（浏览器访问 http://服务器IP:HOST_PORT）
HOST_PORT=5223

# 容器名（同一台机多实例时可改）
CONTAINER_NAME=friends-menu

# 生产须 >=24 位随机串；修改后所有已登录用户需重新登录
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret_please_change

# HTTP 直连 IP:端口 时用 false；HTTPS 反代终止 TLS 时用 true
ADMIN_SESSION_SECURE=false

# 生产是否禁止默认 admin 密码
REQUIRE_NON_DEFAULT_ADMIN_PASSWORD=false

# 容器启动时：自动执行 migrate deploy；若库为空则自动 seed
AUTO_SEED_IF_EMPTY=true

# 可选：ZIP 恢复时容器内拉取公网图片（见 docs/tech-auth.md）
# PUBLIC_SITE_URL=https://你的域名
# INTERNAL_BASE_URL=http://127.0.0.1:3000
